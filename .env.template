# Copy to .env (gitignored) and fill in what you use. Every setting is optional.

# ---------------------------------------------------------------------------
# ATS sweep (sweep_ats.py) — needs NO API keys
# ---------------------------------------------------------------------------

# Directory holding ats_registry.csv.
# Unset: uses ./registry/, falling back to ats_registry.example.csv.
JOBSEARCH_REGISTRY_DIR=

# ---------------------------------------------------------------------------
# Aggregator sweep (sweep.py) — optional, older discovery tool
# Each source is skipped with a log note when its credentials are blank.
# ---------------------------------------------------------------------------

# Directory with Tools/tracker_lookup.py and Search_Results/Jobs_Found_*.md, used to
# skip jobs already applied to or already reviewed. Unset: no dedup.
JOBSEARCH_VAULT_DIR=

# Adzuna — https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble — https://jooble.org/api-for-developers
JOOBLE_API_KEY=

# USAJobs — https://developer.usajobs.gov/ (email must match the one you registered).
# Also used by the ATS sweep's usajobs adapter (backend/ats/adapters.py) — one registry row with
# platform=usajobs enables it, identifier_* are unused. Missing either value skips the adapter
# (one log line), it never fails the sweep.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# To use for Gemini AI Studio LLM calls
GEMINI_API_KEY=
GEMINI_API_MODEL=gemma-4-31b-it,gemma-4-26b-a4b-it

# ---------------------------------------------------------------------------
# Jev typed-decision tier (docs/JEV_PLAN.md) -- optional; the `jevtop` launch step is the Top Jobs demotion pass
# ---------------------------------------------------------------------------
# Path A (default): TypeSafe direct, key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Path B (fallback): Vercel AI Gateway; also set JEV_ENDPOINT=vercel
AI_GATEWAY_API_KEY=
# typesafe | vercel
JEV_ENDPOINT=typesafe
# 1 = run the Jev stage in the daily pipeline (it still needs JEV_LIVE_OK=1)
JEV_STAGE_ENABLED=0
# Spend guards: HTTP requests per run, input tokens per UTC day (5M is about $0.21)
JEV_MAX_CALLS_PER_RUN=400
JEV_DAILY_TOKEN_CAP=5000000
# Live-call approval; leave blank -- set to 1 by the launch.sh Jev preset
JEV_LIVE_OK=

# Finder embeddings backend: st (sentence-transformers) | fastembed | blank = auto
JOBSEARCH_EMBED_BACKEND=
