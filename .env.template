# Copy to .env (gitignored) and fill in what you use. Every setting is optional.

# ---------------------------------------------------------------------------
# ATS sweep (sweep_ats.py) — needs NO API keys
# ---------------------------------------------------------------------------

# Directory holding ats_registry.csv.
# Unset: uses ./registry/, falling back to ats_registry.example.csv.
JOBSEARCH_REGISTRY_DIR=

# ---------------------------------------------------------------------------
# Aggregator sweep (sweep.py) — optional, older discovery tool
# Each source is skipped with a log note when its credentials are blank.
# ---------------------------------------------------------------------------

# Directory with Tools/tracker_lookup.py and Search_Results/Jobs_Found_*.md, used to
# skip jobs already applied to or already reviewed. Unset: no dedup.
JOBSEARCH_VAULT_DIR=

# Adzuna — https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble — https://jooble.org/api-for-developers
JOOBLE_API_KEY=

# USAJobs — https://developer.usajobs.gov/ (email must match the one you registered)
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# To use for Gemini AI Studio LLM calls
GEMINI_API_KEY=
GEMINI_API_MODEL=gemma-4-31b-it,gemma-4-26b-a4b-it

# Finder embeddings backend: st (sentence-transformers) | fastembed | blank = auto
JOBSEARCH_EMBED_BACKEND=
